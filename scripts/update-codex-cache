#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
CACHE_DIR="${HOME}/.codex/plugins/cache/skillz/skillz/1.0.0"

mkdir -p "${CACHE_DIR}"

rsync -a --delete \
  --exclude ".git" \
  --exclude ".claude" \
  "${REPO_ROOT}/" \
  "${CACHE_DIR}/"

echo "Updated Codex Skillz plugin cache: ${CACHE_DIR}"
